/* Site-Nine TUI — Global TCSS Stylesheet
 *
 * Layout:
 *   #content-body / #*-body   — full-height horizontal container
 *   #sidebar                  — narrow left navigation panel
 *   #main-area / #content-area / #dashboard-scroll — main content area
 *   #list-table / #*-table    — DataTable for list pane
 *   #preview-pane             — scrollable preview pane below the list
 *   #fullpage-scroll          — scrollable container in full-page views
 *   #filter-input             — filter input bar
 */

/* =========================================================================
   Global / App
   ========================================================================= */

Screen {
    background: $surface;
}

/* =========================================================================
   Header & Footer
   ========================================================================= */

Header {
    height: 1;
    background: $primary;
    color: $text;
}

Footer {
    height: 1;
    background: $panel;
}

/* =========================================================================
   3-pane layout container
   ========================================================================= */

#content-body,
#epics-body,
#messages-body,
#missions-body,
#tasks-body,
#adrs-body,
#histories-body {
    height: 1fr;
    width: 100%;
}

/* =========================================================================
   Sidebar
   ========================================================================= */

#sidebar {
    width: 16;
    height: 100%;
    background: $panel;
    padding: 1 1;
}

.sidebar-item {
    color: $text-muted;
    padding: 0 1;
}

.sidebar-active {
    color: $accent;
    text-style: bold;
    padding: 0 1;
    background: $surface;
}

/* =========================================================================
   Main area (right of sidebar)
   ========================================================================= */

#main-area,
#content-area {
    height: 100%;
    width: 1fr;
}

/* =========================================================================
   List pane (DataTable)
   ========================================================================= */

#list-table,
#epics-table,
#messages-table,
#missions-table,
#tasks-table,
#adrs-table,
#histories-table {
    height: 1fr;
    width: 100%;
    min-height: 8;
}

/* =========================================================================
   Preview pane
   ========================================================================= */

.preview-pane {
    height: 10;
    width: 100%;
    border-top: solid $primary;
    padding: 0 1;
    background: $panel;
}

/* =========================================================================
   Full-page view
   ========================================================================= */

.fullpage-title {
    height: 1;
    width: 100%;
    padding: 0 1;
    background: $primary;
    color: $text;
}

#fullpage-scroll {
    height: 1fr;
    width: 100%;
    padding: 1 2;
}

/* =========================================================================
   Filter input bar
   ========================================================================= */

#filter-input {
    height: 3;
    width: 100%;
    dock: top;
}

/* =========================================================================
   Dashboard
   ========================================================================= */

#dashboard-scroll {
    height: 1fr;
    width: 1fr;
    padding: 1 2;
}

/* =========================================================================
   Help modal
   ========================================================================= */

HelpScreen {
    align: center middle;
}

#help-scroll {
    width: 70;
    height: 40;
    max-width: 80%;
    max-height: 80%;
    background: $surface;
    border: solid $primary;
    padding: 1 2;
}

/* =========================================================================
   Subview label (Messages screen)
   ========================================================================= */

.subview-label {
    height: 1;
    width: 100%;
    padding: 0 1;
    background: $panel;
}
